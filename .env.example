# Supabase (Postgres, Sydney ap-southeast-2)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Engine API Keys
OPENAI_API_KEY=sk-proj-xxxxxx
GEMINI_API_KEY=AIzaxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxx
GOOGLE_SEARCH_API_KEY=xxxxxx
GOOGLE_SEARCH_CX=xxxxxx

# Resend Email Service (Sending from @aihealthcheck.com.au, replies to help@saas33.com.au)
RESEND_API_KEY=re_xxxxxx
SENDER_EMAIL=reports@aihealthcheck.com.au
TEAM_NOTIFICATION_EMAILS=mark@saas33.com.au,help@saas33.com.au

# Cloudflare Turnstile (Bot protection for public free check)
TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAxxxxxx

# Stripe Payment Links
STRIPE_SECRET_KEY=sk_test_xxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxx

# Application Settings
NODE_ENV=production
APP_URL=https://aihealthcheck.com.au
